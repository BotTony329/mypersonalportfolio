# ---------------------------------------------------------------------------
# Moo, the AI co-pilot — optional.
#
# With no key set the assistant still works: it answers from the local
# knowledge index built out of content/projects/*. Setting a key upgrades
# those answers from retrieved passages to generated prose. Nothing else
# changes, and no page depends on it.
#
# Copy this file to .env.local and fill it in. .env.local is git-ignored;
# never commit a real key.
# ---------------------------------------------------------------------------

# Server-side only. Deliberately has no NEXT_PUBLIC_ prefix, so Next.js will
# refuse to inline it into the browser bundle.
AI_API_KEY=

# Any OpenAI-compatible chat-completions endpoint (DeepSeek, OpenAI, Groq,
# Together, a self-hosted gateway). Defaults to DeepSeek.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Milliseconds before a model call is abandoned and the assistant falls back
# to local retrieval.
AI_TIMEOUT_MS=20000
